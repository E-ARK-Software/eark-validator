<schema xmlns="http://purl.oclc.org/dsdl/schematron">
  <ns prefix="mets" uri="http://www.loc.gov/METS/" />
  <ns prefix="csip" uri="https://DILCIS.eu/XML/METS/CSIPExtensionMETS"/>
  <ns prefix="sip" uri="https://DILCIS.eu/XML/METS/SIPExtensionMETS"/>
  <ns prefix="xlink" uri="http://www.w3.org/1999/xlink" />
  <pattern id="METS_file_element_1">
    <rule context="/mets:mets/mets:fileSec/mets:fileGrp/mets:file">
      <report test="@sip:FILEFORMATNAME">CSIP73;INFO;A file element has an FILEFORMATNAME attribute.</report>
      <report test="@sip:FILEFORMATVERSION">CSIP74;INFO;A file element has an FILEFORMATVERSION attribute.</report>
      <report test="@sip:FILEFORMATREGISTRY">CSIP75;INFO;A file element has an FILEFORMATREGISTRY attribute.</report>
      <report test="@sip:FILEFORMATKEY">CSIP76;INFO;A file element has an FILEFORMATKEY attribute.</report>
    </rule>
  </pattern>
</schema>
